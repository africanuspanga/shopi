{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shopi",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/server.ts",
	"observability": { "enabled": true },
	// Deploys replace the Worker's custom domains with this list, so a domain missing here goes offline.
	// www.shopi.tz is not a Worker domain: a Cloudflare Redirect Rule (dashboard, zone shopi.tz) sends it
	// to shopi.tz with a 301.
	"routes": [{ "pattern": "shopi.tz", "custom_domain": true }],
	"workers_dev": false,
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shopi",
			"database_id": "53388abf-03ae-47f5-becc-e07b85261e50",
			"migrations_dir": "migrations"
		}
	],
	// MEDIA holds photos and is served at /img. BACKUPS is private: the weekly database copies (src/server/jobs.ts).
	"r2_buckets": [
		{ "binding": "MEDIA", "bucket_name": "shopi-media" },
		{ "binding": "BACKUPS", "bucket_name": "shopi-backups" }
	],
	// Web push (src/server/push.ts): the public half of the key pair. The private half is the secret VAPID_PRIVATE_KEY.
	"vars": { "VAPID_PUBLIC_KEY": "BOs5C8-7GroE_fa6Z_9CKv5P54wQhM72EEybJGVoYIsk3VGsJpELSF8PHB45ykXn1qPzDx16gz3svC1_4XHesyU" },
	// NIGHTLY and WEEKLY in src/server/jobs.ts: the clean-up the Privacy page promises, and the database backup.
	"triggers": { "crons": ["0 0 * * *", "30 0 * * SUN"] }
}
