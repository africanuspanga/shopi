{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rizk",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"observability": { "enabled": true },
	// Test site until launch; rizk.tz replaces it when RIZK goes live.
	"routes": [{ "pattern": "rizktz.store", "custom_domain": true }],
	"workers_dev": false,
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rizk",
			"database_id": "e7609dd3-2a48-4e21-ac94-2c5267ea1da2",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "rizk-media" }]
}
